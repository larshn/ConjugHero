{
  "expo": {
    "name": "VerbVenture",
    "slug": "VerbVenture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verbventure.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.verbventure.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "description": "Mestre franske verb med gamification!"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
